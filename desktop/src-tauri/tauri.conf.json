{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChessX",
  "version": "0.6.0",
  "identifier": "io.github.velbtl435hub.chessx",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "title": "ChessX", "width": 1000, "height": 680, "minWidth": 640, "minHeight": 400 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Agentic meta-search in a terminal",
    "externalBin": ["binaries/chessx-engine"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
